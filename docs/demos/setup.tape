Require bundle
Require ruby
Require cat
Set Shell "bash"
Set Width 1600
Set Height 1100
Set FontSize 24
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 15ms
Set Framerate 10
Set WindowBar "Colorful"
Set CursorBlink false
Env PS1 "$ "
Hide
Type "cd tmp/demos"
Enter
Wait+Line /\$$/
Ctrl+L
Show
