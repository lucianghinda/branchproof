module Branchproof
  VERSION: String

  type record = Hash[Symbol, untyped]
  type document = Hash[String | Symbol, untyped]
  type limits = record

  class Error < StandardError
  end

  module Records
    def self.build: (untyped value) -> untyped
    def self.id: (untyped value) -> String
    def self.canonical: (untyped value) -> String
    def self.diagnostic: (code: String | Symbol, severity: String | Symbol, message: String, ?source_id: String?, ?decision_id: String?, ?execution_id: String?, ?test_id: String?, ?details: record) -> record
    def self.source_id: (relative_path: String, digest: String, ?encoding: String) -> String
    def self.condition_id: (String decision_id, Integer index) -> String
    def self.decision_id: (source_id: String, context: String, byte_start: Integer, byte_length: Integer, tree: untyped) -> String
  end

  module Limits
    KEYS: Array[Symbol]
    DEFAULTS: record
    def self.default: () -> limits
    def self.normalize: (?record overrides) -> limits
  end

  class Source
    attr_reader root: String
    attr_reader limits: limits
    def initialize: (root: String, limits: limits) -> void
    def inventory: (paths: Array[String]) -> record
  end

  class Project
    MODES: Array[String]
    FRAMEWORKS: Array[String]
    RAILS_ENVIRONMENT: record
    def initialize: (root: String, ?mode: String, ?framework: String) -> void
    def to_h: () -> record
  end

  class Configuration
    SCHEMA_VERSION: Integer
    PROJECTS: Array[String]
    FRAMEWORKS: Array[String]
    MINIMUM_CRITERIA: Array[String]
    FIELDS: Array[String]
    def self.load: (path: String, root: String, ?explicit: bool, ?disabled: bool) -> record?
  end

  module RailsSupport
    def self.boot: (project: record) -> record
    def self.validate_rspec!: (project: record) -> record?
  end

  class Instrumenter
    RUNTIME: String
    def rewrite: (unit: record) -> record
  end

  class Loader
    STATUS_KEYS: Array[Symbol]
    def initialize: (inventory: record, instrumenter: Instrumenter) -> void
    def install: () -> record
    def load_iseq: (String path) -> untyped
    def diagnostics: () -> Array[record]
  end

  module Runtime
    def self.register_test: (test: record) -> record?
    def self.test_phase_counts: () -> Hash[String, Hash[String, Integer]]
    def self.boot: (evidence: Evidence) -> nil
    def self.enter: (String decision_id) -> nil
    def self.condition: (String decision_id, Integer index, untyped value) -> untyped
    def self.finish: (String decision_id, untyped value) -> untyped
    def self.leave: (String decision_id) -> nil
    def self.flow_candidate: (String decision_id, Integer index) -> nil
    def self.flow_selected: (String decision_id) -> nil
    def self.flow_select: (String decision_id, Integer index) -> nil
    def self.flow_path: (String decision_id, Integer index) -> nil
    def self.flow_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.flow_receiver: (String decision_id, untyped receiver) -> untyped
    def self.flow_assignment_receiver: (String decision_id, untyped receiver) -> untyped
    def self.flow_assignment_path: (String decision_id, Integer index) -> nil
    def self.flow_assignment_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.fallback_operand: (String decision_id, Integer index, bool implicit, untyped value) -> untyped
    def self.exception_enter: (String decision_id, Integer unhandled_index) -> nil
    def self.exception_path: (String decision_id, Integer index) -> nil
    def self.exception_value: (String decision_id, untyped value, Integer index) -> untyped
    def self.exception_finish: (String decision_id, untyped value) -> untyped
    def self.exception_unhandled: (String decision_id) -> nil
    def self.exception_leave: (String decision_id) -> nil
    def self.default_binding: (String decision_id, Integer index) -> nil
    def self.set_alternative_count: (String decision_id, Integer count) -> nil
    def self.value_path: (String decision_id, untyped value, Symbol domain) -> untyped
    def self.dispatch_path: (String decision_id, untyped value, bool raised) -> untyped
    def self.flow_iteration_begin: (String decision_id, untyped receiver, ?Integer alternative_count) -> untyped
    def self.flow_iteration_callback: (String decision_id, ?Integer alternative_count) -> nil
    def self.flow_iteration_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.flow_iteration_leave: (String decision_id) -> nil
    def self.context: (?test_id: String?, ?phase: String?) -> nil
    def self.snapshot: () -> record
    def self.diagnostics: () -> Array[record]
  end

  class Evidence
    SCHEMA_VERSION: String
    CRITERION_VERSION: String
    TOOL_VERSION: String
    attr_reader inventory: record
    attr_reader run_id: String
    def initialize: (inventory: record, limits: limits, run_id: String) -> void
    def register_test: (test: record) -> record
    def record: (execution: record) -> record
    def diagnose: (diagnostic: record) -> nil
    def test_phase_counts: () -> Hash[String, Hash[String, Integer]]
    def snapshot: () -> record
    def merge: (snapshot: record) -> record
  end

  class Analyzer
    CRITERION: String
    def initialize: (inventory: record, evidence: record, limits: limits, ?reachability: bool) -> void
    def call: () -> record
    def pair?: (decision_id: String, condition_index: Integer, left: record, right: record) -> bool
    def missing: (decision_id: String, condition_index: Integer) -> record?
  end

  class CoveragePolicy
    CRITERIA: Hash[String, Hash[Symbol, String]]
    COMPLETENESS_FIELDS: Array[String]
    def self.normalize: (Hash[String | Symbol, untyped] minimum) -> Hash[String, Integer | Float]
    def initialize: (minimum: Hash[String | Symbol, untyped]) -> void
    def call: (document: document?) -> record
  end

  module Constraints
    VERSION: Integer
    NUMERIC_OPERATORS: Array[String]
    COMPARISON_OPERATORS: Array[String]
    OPERATORS: Array[String]
    LITERAL_TYPES: Array[String]
    SUBJECT_KINDS: Array[String]
    REASONS: Array[String]

    class Solver
      def initialize: () -> void
      def add: (record? constraint, bool truth) -> String?
      def add_prepared: (record constraint, bool truth) -> String?
    end

    def self.for_node: (untyped node) -> record?
    def self.usable?: (untyped constraint) -> bool
    def self.message: (untyped reason) -> String
  end

  module DecisionTable
    SCHEMA_VERSION: Integer
    CONSTRAINT_ANALYSIS_VERSION: Integer
    TRUE_VALUE: String
    FALSE_VALUE: String
    DONT_CARE: String
    CONDITION_VALUES: Array[String]
    VALUE_LABELS: Hash[String, String]
    REACHABILITY_STATUSES: Array[String]
    COVERAGE_STATUSES: Array[String]
    TABLE_STATUSES: Array[String]
    NOT_CALCULATED_REASONS: Array[String]
    DEFAULT_MAX_CONDITIONS: Integer
    DEFAULT_MAX_RULES: Integer

    def self.build: (decision: record, ?vectors: Array[record], ?limits: limits, ?reachability: bool) -> record
    def self.rule_id: (String decision_id, Array[String] values, bool outcome) -> String
    def self.coverage_entry: (record table) -> record
    def self.unsupported_coverage_entry: () -> record
  end

  class Minimizer
    def initialize: (analysis: record, evidence: record, limits: limits) -> void
    def call: (objective: Symbol, decision_ids: Array[String]) -> record
  end

  class MinitestAdapter
    def initialize: (runtime: untyped) -> void
    def capabilities: () -> record
    def run: (test_files: Array[String], runner_args: Array[String], on_complete: ^(record) -> untyped, ?before_load: ^() -> untyped?) -> nil
  end

  class RSpecAdapter
    class UnsupportedRunner < ArgumentError
      def diagnostic_code: () -> String
    end

    FORBIDDEN_OPTIONS: Hash[Symbol, String]
    attr_reader tests: Hash[String, record]
    def self.active_adapter: () -> RSpecAdapter?
    def self.active_adapter=: (RSpecAdapter?) -> RSpecAdapter?
    def self.runner_adapter: () -> RSpecAdapter?
    def self.runner_adapter=: (RSpecAdapter?) -> RSpecAdapter?
    attr_reader late_execution_error: ArgumentError?
    def initialize: (runtime: untyped) -> void
    def reject_execution!: (String message) -> bot
    def enter_runner!: (untyped runner) -> bool
    def example_started: (untyped notification) -> untyped
    def example_finished: (untyped notification) -> untyped
    def run: (test_files: Array[String], runner_args: Array[String], on_complete: ^(record) -> untyped, ?before_load: ^() -> untyped?, ?after_load: ^() -> untyped?, ?test_selection_explicit: bool) -> untyped
    def validate_runner!: () -> nil
  end

  module Worker
    def self.child_process: (String config_path) -> Integer?
    def self.adapter_for: (record project, untyped runtime) -> (MinitestAdapter | RSpecAdapter)
    def self.guard_late_rspec_execution: (RSpecAdapter adapter, Hash[String, untyped] payload) -> untyped
    def self.legacy_project: () -> Hash[String, untyped]
    def self.prepend_load_paths: (record project) -> nil
    def self.boot_project: (record project) -> record?
    def self.project_metadata: (record project, record? rails_metadata) -> record
    def self.completion_result: (baseline: record, project: record, rails_metadata: record?, evidence: record, tests: Array[record], diagnostics: Array[record]) -> record
    def self.incomplete_evidence: (record evidence, Array[record] diagnostics) -> record
    def self.write_completion: (Hash[String, untyped] payload, record result) -> nil
    def self.write_failure: (Hash[String, untyped] payload, String code, untyped details) -> nil
    def self.project_metadata_for: (Hash[String, untyped] payload) -> record
    def self.symbolize: (untyped value) -> untyped
    def self.normalize: (untyped value) -> untyped
  end

  class Report
    SCHEMA_VERSION: String
    CHANGED_SCOPE_SCHEMA_VERSION: String
    CRITERION_VERSION: String
    VIEWS: Array[Symbol]
    FORMATS: Array[Symbol]
    def initialize: (inventory: document, evidence: document, analysis: document?, minima: Array[document], baseline: document, diagnostics: Array[document], ?level: Integer, ?missing_only: bool, ?view: Symbol, ?run_metadata: document, ?saved_document: document?, ?focus: String?, ?top: (Integer | String)?, ?minimum: document?, ?changed_scope: document?) -> void
    def self.from_document: (document: document, ?level: Integer?, ?view: Symbol, ?missing_only: bool, ?focus: String?, ?top: (Integer | String)?, ?minimum: document?) -> Report
    def diagnostic_message: (Hash[Symbol | String, untyped] diagnostic) -> String
    def condition_explanation: (decision_id: String, condition_id: String) -> String
    def decision_table_requirement: (untyped value) -> String?
    def decision_table_reachability: (document rule) -> String
    def decision_table_expected_heading: (document decision) -> String
    def coverage_policy: () -> record
    def coverage_policy_lines: () -> Array[String]
    def changed_scope_lines: () -> Array[String]
    def changed_coverage_available?: () -> bool
    def display_scope_path: (String path) -> String
    def rerun_command: (String test_id) -> String?
    def write: (io: _WriteIO, format: Symbol | String, ?path_prefix: String?) -> nil
    def step_summary: () -> String
    def exit_code: () -> Integer
  end

  class ChangedScope
    def initialize: (root: String, ref: String) -> void
    def call: (inventory: record) -> record
  end

  class GitChanges
    def initialize: (root: String, ref: String) -> void
    def call: (?include_patch_lines: bool) -> record
  end

  class ChangedDecisionMap
    def call: (bytes: String, path: String, decisions: Array[record], hunks: Array[record], ?old_bytes: String) -> Array[String]
  end

  module ChangedCoverage
    def self.call: (document: document, scope: record) -> record
  end

  module CoverageSummary
    def self.call: (Array[record] decisions) -> record
    def self.decision_table_aggregate: (Array[record] boolean_supported) -> record
    def self.alternative_aggregate: (Array[record] decisions) -> record
    def self.alternative_decision?: (record decision) -> bool
  end

  class CoverageIndex
    def initialize: (document: document) -> void
    attr_reader conditions: Array[record]
    attr_reader alternatives: Array[record]
    attr_reader tests: Array[record]
    attr_reader decision_tables: Array[record]
  end

  class FocusedReport
    def initialize: (document: document, view: Symbol, level: Integer, ?missing_only: bool, ?coordinator: Report?, ?focus: String?, ?top: (Integer | String)?, ?selection: ReportSelection?) -> void
    def render: () -> String
  end

  class SummaryRanking
    class Decision
      attr_reader id: String
      attr_reader relative_path: String?
      attr_reader line: Integer?
      attr_reader column: Integer?
      attr_reader expression: String
      attr_reader kind: String
      attr_reader context: String?
      attr_reader unexecuted: bool
      attr_reader missing_rules: Array[record]
      attr_reader required_rules: Integer
      attr_reader table_calculated: bool
      attr_reader unproven_conditions: Array[record]
      attr_reader conditions: Array[record]
      attr_reader missing_alternatives: Array[record]
      attr_reader alternatives: Array[record]
      attr_reader test_ids: Array[String]
      def missing_total: () -> Integer
      def gap?: () -> bool
      def cases_to_test: () -> Integer
      def rule_cases?: () -> bool
    end

    class SourceFile
      attr_reader relative_path: String?
      attr_reader decisions: Array[Decision]
      def gaps: () -> Integer
      def unexecuted: () -> Integer
      def missing_rules: () -> Integer
      def required_rules: () -> Integer
      def unproven_conditions: () -> Integer
      def conditions: () -> Integer
      def missing_alternatives: () -> Integer
      def alternatives: () -> Integer
      def missing_total: () -> Integer
    end

    attr_reader index: CoverageIndex
    def initialize: (document: document, ?selection: ReportSelection) -> void
    def available?: () -> bool
    def decisions: () -> Array[Decision]
    def gaps: () -> Array[Decision]
    def files: () -> Array[SourceFile]
    def unsupported_count: () -> Integer
  end

  class SummaryReport
    ORDER_NOTE: String
    def initialize: (document: document, level: Integer, coordinator: Report, ?missing_only: bool, ?selection: ReportSelection) -> void
    def render: () -> String
    def self.gap_summary: (SummaryRanking::Decision decision) -> String
    def self.case_lines: (SummaryRanking::Decision decision, Report coordinator) -> Array[String]
    def self.one_line: (String text, ?Integer width) -> String
    def self.rule_text: (record rule, Array[String] expressions, Report coordinator) -> String
  end

  class GithubReport
    MARKDOWN_ROWS: Integer
    def initialize: (document: document, level: Integer, coordinator: Report, ?selection: ReportSelection, ?path_prefix: String?) -> void
    def annotations: (?path_prefix: String?) -> String
    def step_summary: () -> String
  end

  class CLI
    def initialize: (stdout: _WriteIO, stderr: _WriteIO, ?env: _Env) -> void
    def call: (Array[String] argv) -> Integer
  end

  class ReportSelection
    attr_reader focus: record?
    attr_reader top: Integer?
    attr_reader decision_ids: Array[String]?
    def initialize: (?focus: String?, ?top: (Integer | String)?, ?decision_ids: Array[String]?) -> void
    def active?: () -> bool
    def focus_active?: () -> bool
    def decision_filter_active?: () -> bool
    def focus_label: () -> String?
    def matching_decision_ids: (document document) -> Array[String]
    def selected_decision_ids: (document document) -> Array[String]?
    def filter_decisions: (Array[record] decisions, ?inventory: document) -> Array[record]
    def limit: (Array[record] items) -> [Array[record], Integer]
    def sort_key: (record decision, ?inventory: document) -> [String, Integer, Integer, String]
  end

  class SavedReport
    def self.read: (String path) -> document
  end

  class Comparison
    def initialize: (before: document, after: document) -> void
    def call: () -> document
  end

  class ComparisonReport
    def initialize: (document: document) -> void
    def write: (io: _WriteIO, format: Symbol | String) -> nil
    def exit_code: (?fail_on_regression: bool) -> Integer
  end

  class RakeTask < Rake::TaskLib
    OPTIONS: Array[Symbol]
    REPEATED_FLAGS: Hash[Symbol, String]
    DEFAULTS: Hash[Symbol, untyped]
    attr_reader name: Symbol
    attr_accessor description: String
    attr_reader sources: Array[String]
    attr_reader tests: Array[String]
    attr_reader project: String
    attr_reader framework: String
    attr_reader view: String
    attr_reader level: Integer
    attr_reader missing_only: bool
    attr_reader minimum: Array[String]
    attr_reader format: String
    attr_reader output: String?
    attr_reader runner_args: Array[String]
    def initialize: (?Symbol | String name) ?{ (RakeTask) -> void } -> void
    def sources=: (Array[String] | String value) -> Array[String]
    def tests=: (Array[String] value) -> Array[String]
    def project=: (String value) -> String
    def framework=: (String value) -> String
    def view=: (String value) -> String
    def level=: (Integer value) -> Integer
    def missing_only=: (bool value) -> bool
    def minimum=: (Array[String] value) -> Array[String]
    def format=: (String value) -> String
    def output=: (String? value) -> String?
    def runner_args=: (Array[String] | String value) -> Array[String]
    def argv: () -> Array[String]
    def command: () -> Array[String]
    def executable: () -> String
    def run: () -> void
  end

  interface _Env
    def []: (String) -> String?
  end

  interface _WriteIO
    def write: (String) -> Integer
  end
end

module MCDC
end
