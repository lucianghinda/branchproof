module Branchproof
  VERSION: String

  type record = Hash[Symbol, untyped]
  type document = Hash[String | Symbol, untyped]
  type limits = record

  class Error < StandardError
  end

  module Records
    def self.build: (untyped value) -> untyped
    def self.id: (untyped value) -> String
    def self.canonical: (untyped value) -> String
    def self.diagnostic: (code: String | Symbol, severity: String | Symbol, message: String, ?source_id: String?, ?decision_id: String?, ?execution_id: String?, ?test_id: String?, ?details: record) -> record
    def self.source_id: (relative_path: String, digest: String, ?encoding: String) -> String
    def self.condition_id: (String decision_id, Integer index) -> String
    def self.decision_id: (source_id: String, context: String, byte_start: Integer, byte_length: Integer, tree: untyped) -> String
  end

  module Limits
    KEYS: Array[Symbol]
    DEFAULTS: record
    def self.default: () -> limits
    def self.normalize: (?record overrides) -> limits
  end

  class Source
    attr_reader root: String
    attr_reader limits: limits
    def initialize: (root: String, limits: limits) -> void
    def inventory: (paths: Array[String]) -> record
  end

  class Project
    MODES: Array[String]
    FRAMEWORKS: Array[String]
    RAILS_ENVIRONMENT: record
    def initialize: (root: String, ?mode: String, ?framework: String) -> void
    def to_h: () -> record
  end

  class Configuration
    SCHEMA_VERSION: Integer
    PROJECTS: Array[String]
    FRAMEWORKS: Array[String]
    MINIMUM_CRITERIA: Array[String]
    FIELDS: Array[String]
    def self.load: (path: String, root: String, ?explicit: bool, ?disabled: bool) -> record?
  end

  module RailsSupport
    def self.boot: (project: record) -> record
    def self.validate_rspec!: (project: record) -> record?
  end

  class Instrumenter
    RUNTIME: String
    def rewrite: (unit: record) -> record
  end

  class Loader
    STATUS_KEYS: Array[Symbol]
    def initialize: (inventory: record, instrumenter: Instrumenter) -> void
    def install: () -> record
    def load_iseq: (String path) -> untyped
    def diagnostics: () -> Array[record]
  end

  module Runtime
    def self.register_test: (test: record) -> record?
    def self.test_phase_counts: () -> Hash[String, Hash[String, Integer]]
    def self.boot: (evidence: Evidence) -> nil
    def self.enter: (String decision_id) -> nil
    def self.condition: (String decision_id, Integer index, untyped value) -> untyped
    def self.finish: (String decision_id, untyped value) -> untyped
    def self.leave: (String decision_id) -> nil
    def self.flow_candidate: (String decision_id, Integer index) -> nil
    def self.flow_selected: (String decision_id) -> nil
    def self.flow_select: (String decision_id, Integer index) -> nil
    def self.flow_path: (String decision_id, Integer index) -> nil
    def self.flow_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.flow_receiver: (String decision_id, untyped receiver) -> untyped
    def self.flow_assignment_receiver: (String decision_id, untyped receiver) -> untyped
    def self.flow_assignment_path: (String decision_id, Integer index) -> nil
    def self.flow_assignment_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.exception_enter: (String decision_id, Integer unhandled_index) -> nil
    def self.exception_path: (String decision_id, Integer index) -> nil
    def self.exception_value: (String decision_id, untyped value, Integer index) -> untyped
    def self.exception_finish: (String decision_id, untyped value) -> untyped
    def self.exception_unhandled: (String decision_id) -> nil
    def self.exception_leave: (String decision_id) -> nil
    def self.default_binding: (String decision_id, Integer index) -> nil
    def self.set_alternative_count: (String decision_id, Integer count) -> nil
    def self.value_path: (String decision_id, untyped value, Symbol domain) -> untyped
    def self.dispatch_path: (String decision_id, untyped value, bool raised) -> untyped
    def self.flow_iteration_begin: (String decision_id, untyped receiver, ?Integer alternative_count) -> untyped
    def self.flow_iteration_callback: (String decision_id, ?Integer alternative_count) -> nil
    def self.flow_iteration_finish: (String decision_id, untyped value, ?Integer? default_path) -> untyped
    def self.flow_iteration_leave: (String decision_id) -> nil
    def self.context: (?test_id: String?, ?phase: String?) -> nil
    def self.snapshot: () -> record
    def self.diagnostics: () -> Array[record]
  end

  class Evidence
    SCHEMA_VERSION: String
    CRITERION_VERSION: String
    TOOL_VERSION: String
    attr_reader inventory: record
    attr_reader run_id: String
    def initialize: (inventory: record, limits: limits, run_id: String) -> void
    def register_test: (test: record) -> record
    def record: (execution: record) -> record
    def diagnose: (diagnostic: record) -> nil
    def test_phase_counts: () -> Hash[String, Hash[String, Integer]]
    def snapshot: () -> record
    def merge: (snapshot: record) -> record
  end

  class Analyzer
    CRITERION: String
    def initialize: (inventory: record, evidence: record, limits: limits, ?reachability: bool) -> void
    def call: () -> record
    def pair?: (decision_id: String, condition_index: Integer, left: record, right: record) -> bool
    def missing: (decision_id: String, condition_index: Integer) -> record?
  end

  module Constraints
    VERSION: Integer
    NUMERIC_OPERATORS: Array[String]
    COMPARISON_OPERATORS: Array[String]
    OPERATORS: Array[String]
    LITERAL_TYPES: Array[String]
    SUBJECT_KINDS: Array[String]
    REASONS: Array[String]

    class Solver
      def initialize: () -> void
      def add: (record? constraint, bool truth) -> String?
      def add_prepared: (record constraint, bool truth) -> String?
    end

    def self.for_node: (untyped node) -> record?
    def self.usable?: (untyped constraint) -> bool
    def self.message: (untyped reason) -> String
  end

  module DecisionTable
    SCHEMA_VERSION: Integer
    CONSTRAINT_ANALYSIS_VERSION: Integer
    TRUE_VALUE: String
    FALSE_VALUE: String
    DONT_CARE: String
    CONDITION_VALUES: Array[String]
    VALUE_LABELS: Hash[String, String]
    REACHABILITY_STATUSES: Array[String]
    COVERAGE_STATUSES: Array[String]
    TABLE_STATUSES: Array[String]
    NOT_CALCULATED_REASONS: Array[String]
    DEFAULT_MAX_CONDITIONS: Integer
    DEFAULT_MAX_RULES: Integer

    def self.build: (decision: record, ?vectors: Array[record], ?limits: limits, ?reachability: bool) -> record
    def self.rule_id: (String decision_id, Array[String] values, bool outcome) -> String
    def self.coverage_entry: (record table) -> record
    def self.unsupported_coverage_entry: () -> record
  end

  class Minimizer
    def initialize: (analysis: record, evidence: record, limits: limits) -> void
    def call: (objective: Symbol, decision_ids: Array[String]) -> record
  end

  class MinitestAdapter
    def initialize: (runtime: untyped) -> void
    def capabilities: () -> record
    def run: (test_files: Array[String], runner_args: Array[String], on_complete: ^(record) -> untyped, ?before_load: ^() -> untyped?) -> nil
  end

  class RSpecAdapter
    class UnsupportedRunner < ArgumentError
      def diagnostic_code: () -> String
    end

    FORBIDDEN_OPTIONS: Hash[Symbol, String]
    attr_reader tests: Hash[String, record]
    def self.active_adapter: () -> RSpecAdapter?
    def self.active_adapter=: (RSpecAdapter?) -> RSpecAdapter?
    def self.runner_adapter: () -> RSpecAdapter?
    def self.runner_adapter=: (RSpecAdapter?) -> RSpecAdapter?
    attr_reader late_execution_error: ArgumentError?
    def initialize: (runtime: untyped) -> void
    def reject_execution!: (String message) -> bot
    def enter_runner!: (untyped runner) -> bool
    def example_started: (untyped notification) -> untyped
    def example_finished: (untyped notification) -> untyped
    def run: (test_files: Array[String], runner_args: Array[String], on_complete: ^(record) -> untyped, ?before_load: ^() -> untyped?, ?after_load: ^() -> untyped?, ?test_selection_explicit: bool) -> untyped
    def validate_runner!: () -> nil
  end

  class Report
    SCHEMA_VERSION: String
    CRITERION_VERSION: String
    VIEWS: Array[Symbol]
    def initialize: (inventory: document, evidence: document, analysis: document?, minima: Array[document], baseline: document, diagnostics: Array[document], ?level: Integer, ?missing_only: bool, ?view: Symbol, ?run_metadata: document, ?saved_document: document?) -> void
    def self.from_document: (document: document, ?level: Integer?, ?view: Symbol, ?missing_only: bool) -> Report
    def diagnostic_message: (Hash[Symbol | String, untyped] diagnostic) -> String
    def condition_explanation: (decision_id: String, condition_id: String) -> String
    def decision_table_requirement: (untyped value) -> String?
    def decision_table_reachability: (document rule) -> String
    def decision_table_expected_heading: (document decision) -> String
    def rerun_command: (String test_id) -> String?
    def write: (io: _WriteIO, format: Symbol | String) -> nil
    def exit_code: () -> Integer
  end

  class CoverageIndex
    def initialize: (document: document) -> void
    attr_reader conditions: Array[record]
    attr_reader alternatives: Array[record]
    attr_reader tests: Array[record]
    attr_reader decision_tables: Array[record]
  end

  class FocusedReport
    def initialize: (document: document, view: Symbol, level: Integer, ?missing_only: bool) -> void
    def render: () -> String
  end

  class SavedReport
    def self.read: (String path) -> document
  end

  class Comparison
    def initialize: (before: document, after: document) -> void
    def call: () -> document
  end

  class ComparisonReport
    def initialize: (document: document) -> void
    def write: (io: _WriteIO, format: Symbol | String) -> nil
    def exit_code: (?fail_on_regression: bool) -> Integer
  end

  interface _WriteIO
    def write: (String) -> Integer
  end
end

module MCDC
end
